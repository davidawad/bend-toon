#!/bin/sh
# The content hash `bend main.bend --publish` would print for this package,
# computed without publishing anything. Mirrors bend 2.0.38's cli_publish:
#   files = main.bend + every file it imports (transitively, Base excluded)
#           + a LICENSE sitting beside any of them
#   hash  = "0x" + first 32 hex digits of
#           sha256 of the concatenation, over the paths sorted bytewise, of
#           "<sha256 of the file> <path>\n"
# usage: sh scripts/pkg-hash [entry.bend]    (run from the repository root;
#        VERBOSE=1 also lists the published files)
set -eu
entry=${1:-main.bend}
work=$(mktemp)
trap 'trash "$work" 2>/dev/null || true' EXIT

# Print the path of each file imported by $1, relative to the root.
imports() {
  dir=$(dirname "$1")
  sed -n 's/^import \(\.\{1,2\}\/[^ ]*\) as .*/\1/p' "$1" | while read -r rel; do
    # normalise dir/rel without realpath
    printf '%s\n' "$dir/$rel" | awk -F/ '{
      n = 0
      for (i = 1; i <= NF; i++) {
        if ($i == "." || $i == "") continue
        if ($i == ".." && n > 0) { n-- } else { n++; p[n] = $i }
      }
      s = p[1]; for (i = 2; i <= n; i++) s = s "/" p[i]
      print s
    }'
  done
}

printf '%s\n' "$entry" > "$work"
i=1
while [ "$i" -le "$(wc -l < "$work" | tr -d ' ')" ]; do
  f=$(sed -n "${i}p" "$work")
  for g in $(imports "$f"); do
    grep -qx "$g" "$work" || printf '%s\n' "$g" >> "$work"
  done
  i=$((i + 1))
done

# LICENSE files beside the published files
for f in $(cat "$work"); do
  d=$(dirname "$f")
  l="$d/LICENSE"
  [ "$d" = "." ] && l="LICENSE"
  if [ -f "$l" ]; then grep -qx "$l" "$work" || printf '%s\n' "$l" >> "$work"; fi
done

LC_ALL=C sort "$work" | while read -r p; do
  printf '%s %s\n' "$(shasum -a 256 "$p" | cut -d' ' -f1)" "$p"
done | { cat; } > "$work.lines"
count=$(wc -l < "$work.lines" | tr -d ' ')
bytes=0
for p in $(cut -d' ' -f2 "$work.lines"); do bytes=$((bytes + $(wc -c < "$p" | tr -d ' '))); done
h=$(shasum -a 256 "$work.lines" | cut -c1-32)
if [ "${VERBOSE:-}" = 1 ]; then cut -d' ' -f2 "$work.lines"; fi
trash "$work.lines" 2>/dev/null || true
echo "files: $count, bytes: $bytes"
echo "0x$h"
